# --- LM Studio (local OpenAI-compatible server) ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct-1m

# --- Embeddings / reranker (run locally) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# --- Storage ---
CHROMA_PATH=./chroma_db
UPLOAD_PATH=./uploads
EVAL_PATH=./evaluation_results

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=8
CANDIDATE_K=20
RERANK_TOP_K=5
MIN_SIMILARITY=0.20
HISTORY_WINDOW=6

# --- Limits ---
MAX_FILE_SIZE_MB=50

DEBUG=true

# Optional: PostgreSQL for query history, e.g. postgresql://user:pass@localhost:5432/dataanalyst
DATABASE_URL=
